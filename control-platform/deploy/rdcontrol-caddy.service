[Unit]
Description=HTTPS entry for private control platform
After=network-online.target rdcontrol.service
Wants=network-online.target rdcontrol.service

[Service]
User=rdcontrol-caddy
Group=rdcontrol-caddy
Environment=XDG_DATA_HOME=/var/lib/rdcontrol-caddy
Environment=XDG_CONFIG_HOME=/var/lib/rdcontrol-caddy
Environment=NO_PROXY=127.0.0.1,localhost,::1
ExecStart=/opt/rdcontrol/current/deploy/caddy run --config /opt/rdcontrol/current/deploy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rdcontrol-caddy

[Install]
WantedBy=multi-user.target
