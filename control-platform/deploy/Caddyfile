{
	admin off
	default_sni 8.138.230.183
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

https://8.138.230.183 {
	tls internal
	@client path /api/auth/login /api/auth/refresh /api/auth/logout /api/me /ws/id /ws/relay
	handle @client {
		reverse_proxy 127.0.0.1:8088 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		respond "Not found" 404
	}
}
